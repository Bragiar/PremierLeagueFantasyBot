[Unit]
Description=Refresh official FPL deadlines without AI research
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/apps/fpl-bot
Environment=PATH=%h/.openclaw/tools/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/apps/fpl-bot/.venv/bin/python -m fpl_bot.server_scheduler --repo-root %h/apps/fpl-bot
TimeoutStartSec=5min
Restart=on-failure
RestartSec=10min
UMask=0077
